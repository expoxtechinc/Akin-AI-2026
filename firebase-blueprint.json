{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User specific settings and metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "aiName": { "type": "string" },
        "voice": { "type": "string" },
        "style": { "type": "string" },
        "location": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "aiName"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "A single message in the chat history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "timestamp": { "type": "number" },
        "feedback": { "type": "string", "enum": ["up", "down"] }
      },
      "required": ["id", "role", "content", "timestamp"]
    },
    "Task": {
      "title": "Task",
      "description": "A task or to-do item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "completed": { "type": "boolean" },
        "dueDate": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "completed", "priority"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Primary user profile document"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": "Message",
      "description": "User's chat history messages"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "User's individual tasks"
    }
  }
}
